    "#given a list that is connected to another. Like a dictionary. How do I get only values in a window\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "voltage = np.linspace(3, 4.2, 1000)\n",
    "\n",
    "window = voltage[(voltage >3) & (voltage < 3.02)]\n",
    "window"
